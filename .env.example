# FareScout — flight data provider (optional).
#
# With NO keys set, the app runs on a deterministic offline data engine and is
# fully functional (ranked deals, baseline learning, points optimization).
#
# Provider: Amadeus Self-Service (https://developers.amadeus.com).
# Create a free Self-Service app to get an API Key + API Secret.

VITE_AMADEUS_CLIENT_ID=
VITE_AMADEUS_CLIENT_SECRET=

# 'test' (free sandbox, limited data) or 'production' (paid, real fares).
VITE_AMADEUS_ENV=test

# ⚠️ Amadeus does not send CORS headers, so the browser cannot call it directly
# in production. Run a thin proxy/serverless function that injects the
# credentials and forwards to Amadeus, then point this at it (e.g.
# https://your-proxy.example.com/amadeus). When set, the app calls the proxy
# instead of Amadeus directly and CLIENT_ID/SECRET can live on the proxy.
VITE_AMADEUS_PROXY=
